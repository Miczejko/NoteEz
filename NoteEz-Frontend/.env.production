# Vite laduje ten plik automatycznie przy "vite build" (domyslny mode to "production") -
# dzieki temu dziala tez w Cloudflare (ktory buduje z czystego klona repo i nie widzi
# lokalnego .env, bo ten jest w .gitignore). Zadna z tych dwoch wartosci nie jest
# sekretem - obie i tak trafiaja jawnie do publicznego bundla JS w przegladarce.
VITE_API_URL=https://api.twoja-domena.pl/api
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
