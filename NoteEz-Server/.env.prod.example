# Skopiuj ten plik jako .env.prod na serwerze i uzupelnij prawdziwymi wartosciami.
# .env.prod NIE powinien trafic do gita.

# Connection string do istniejacej bazy Azure SQL (zostaje na Azure na razie)
ConnectionStrings__DefaultConnection=Server=tcp:<twoj-serwer>.database.windows.net,1433;Initial Catalog=<baza>;User ID=<user>;Password=<haslo>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

ConnectionStrings__BlobStorage=<azure-blob-connection-string>
BlobStorage__ContainerName=<nazwa-kontenera>

Jwt__Key=<dlugi-losowy-sekret>
Jwt__Issuer=NoteEz
Jwt__Audience=NoteEz

Cors__AllowedOrigins__0=https://twoja-domena-frontendu.pl

SendGrid__ApiKey=<sendgrid-api-key>
SendGrid__FromEmail=<from-email>
SendGrid__FromName=NoteEz

App__FrontendBaseUrl=https://twoja-domena-frontendu.pl
App__BackendBaseUrl=https://api.twoja-domena.pl

Turnstile__SecretKey=<turnstile-secret>
